# MongoDB Atlas connection string. In Atlas > Network Access, allow 0.0.0.0/0
# (Render/Vercel have no fixed outbound IP) or the connection will time out.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ai-tools?retryWrites=true&w=majority

# Comma-separated frontend origins allowed by CORS (no trailing slash).
# "*" matches one subdomain label, e.g. https://ai-website-*.vercel.app for preview deploys.
CLIENT_URL=https://your-frontend.vercel.app

# Secret for admin endpoints (X-API-Key header / Admin page). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=replace-with-a-long-random-string

# Optional
# PORT=5000
# NODE_ENV=production
# TRUST_PROXY=1
